{
    "version": 2,
    "buildCommand": "cd Cranberry-Frontend && npm install && npm run build",
    "outputDirectory": "Cranberry-Frontend/dist",
    "framework": null,
    "installCommand": "cd Cranberry-Frontend && npm install",
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "https://your-backend-api-url.com/api/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
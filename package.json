{
    "name": "cranberry-marketplace",
    "version": "1.0.0",
    "description": "AI-Powered Multi-Vendor E-Commerce Marketplace",
    "main": "index.js",
    "scripts": {
        "build": "cd Cranberry-Frontend && npm install && npm run build",
        "dev": "cd Cranberry-Frontend && npm run dev",
        "start": "cd Cranberry-Frontend && npm run preview",
        "install-frontend": "cd Cranberry-Frontend && npm install",
        "clean": "cd Cranberry-Frontend && rm -rf dist node_modules && npm install",
        "deploy": "vercel --prod",
        "preview": "cd Cranberry-Frontend && npm run build && npm run preview"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/aryangaikwad-966/Cranberry-AI-Powered-Multi-Vendor-E-Commerce-Platform-.git"
    },
    "keywords": [
        "ecommerce",
        "marketplace",
        "ai",
        "react",
        "spring-boot"
    ],
    "author": "Aryan Gaikwad",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=8.0.0"
    }
}